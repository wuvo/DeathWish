            P.WriteInt16((ushort)10010);
            P.WriteInt32(Identifier);
            P.WriteInt32(Value1);
            P.WriteInt32(Native.timeGetTime());
            P.WriteInt16(Type);
            P.WriteInt16(Direction);
            P.WriteInt16(Value2);
            P.WriteInt16(Value3);            
            P.Move(4);
            return P;
        }
