            COPacket P = new COPacket(Packet);

            P.WriteInt16((ushort)(Packet.Length - 8));
            P.WriteInt16((ushort)0x451);
            P.WriteInt32(EntityID);
            P.WriteInt16(X);
            P.WriteInt16(Y);
            P.WriteInt16(SkillId);
            P.WriteInt16(SkillLvl);
