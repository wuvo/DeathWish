        public static COPacket ViewEquip(Game.Character C)
        {
            byte[] Packet = new byte[8 + 11 + "None".Length];
            COPacket P = new COPacket(Packet);
            P.WriteInt16((ushort)(Packet.Length - 8));
            P.WriteInt16((ushort)0x3f7);
            P.WriteInt32(C.EntityID);
            P.WriteByte(0x0a);
            P.WriteByte(0x01);
