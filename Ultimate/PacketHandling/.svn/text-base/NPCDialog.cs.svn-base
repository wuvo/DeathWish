                            #region Birth Village Idiots
                            case 10010:
                                {

                                    if (Control == 0)
                                    {
                                        GC.AddSend(Packets.NPCSay("Do you want to leave?"));
                                        GC.AddSend(Packets.NPCLink("Yeah.", 1));
