                                    {
                                        Game.Item I = GC.MyChar.Equips.RightHand;
                                        if (I.ID != 0)
                                        {
                                            if (I.Soc1 == NewestCOServer.Game.Item.Gem.NoSocket)
                                            {
                                                if (GC.MyChar.InventoryContains(1088000, 1))
                                                {
                                                    GC.MyChar.EquipStats(4, false);
                                                    GC.MyChar.RemoveItem(GC.MyChar.NextItem(1088000));
                                                    I.Soc1 = NewestCOServer.Game.Item.Gem.EmptySocket;
                                                    GC.MyChar.Equips.Replace(4, I, GC.MyChar);
                                                    GC.MyChar.EquipStats(4, true);

                                                    GC.AddSend(Packets.NPCSay("It was a success! But it's not like i ever fail anyways."));
                                                    GC.AddSend(Packets.NPCLink("Cool. Thanks.", 255));
                                                    GC.AddSend(Packets.NPCSetFace(N.Avatar));
                                                    GC.AddSend(Packets.NPCFinish());
                                                }
                                            }
                                            else if (I.Soc2 == NewestCOServer.Game.Item.Gem.NoSocket)
                                            {
                                                if (GC.MyChar.InventoryContains(1088000, 5))
                                                {
                                                    GC.MyChar.EquipStats(4, false);
                                                    for (int i = 0; i < 5; i++)
                                                        GC.MyChar.RemoveItem(GC.MyChar.NextItem(1088000));
                                                    I.Soc2 = NewestCOServer.Game.Item.Gem.EmptySocket;
                                                    GC.MyChar.Equips.Replace(4, I, GC.MyChar);
                                                    GC.MyChar.EquipStats(4, true);

                                                    GC.AddSend(Packets.NPCSay("It was a success! But it's not like i ever fail anyways."));
                                                    GC.AddSend(Packets.NPCLink("Cool. Thanks.", 255));
                                                    GC.AddSend(Packets.NPCSetFace(N.Avatar));
                                                    GC.AddSend(Packets.NPCFinish());
                                                }
                                            }
                                            else
                                            {
                                                GC.AddSend(Packets.NPCSay("Is your weapon somekind of magic weapon, because it just wasn't 2 socketed?"));
                                                GC.AddSend(Packets.NPCLink("Maybe...", 255));
                                                GC.AddSend(Packets.NPCSetFace(N.Avatar));
                                                GC.AddSend(Packets.NPCFinish());
                                            }
                                        }
                                        else
                                        {
                                            GC.AddSend(Packets.NPCSay("What the ****, where did you put your weapon? Stop playing tricks on me!"));
                                            GC.AddSend(Packets.NPCLink("Oops, sorry.", 255));
                                            GC.AddSend(Packets.NPCSetFace(N.Avatar));
                                            GC.AddSend(Packets.NPCFinish());
                                        }
                                    }
                                    else if (Control == 10)
                                    {
                                        GC.AddSend(Packets.NPCSay("Well..... I don't know, i just want them because they're shiny!"));
                                        GC.AddSend(Packets.NPCLink("Yeah, didn't think a socket would need them.", 255));
                                        GC.AddSend(Packets.NPCSetFace(N.Avatar));
                                        GC.AddSend(Packets.NPCFinish());
                                    }
                                    break;
                                }
                            #endregion
