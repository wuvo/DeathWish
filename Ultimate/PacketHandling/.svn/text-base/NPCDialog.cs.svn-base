                                                for (byte i = 0; i < 18; i++)
                                                    GC.MyChar.RemoveItem(GC.MyChar.NextItem(1088000));
                                                GC.MyChar.Silvers -= 250000;
                                                Eq.Soc1 = NewestCOServer.Game.Item.Gem.EmptySocket;
                                                GC.MyChar.Equips.Replace(Pos, Eq, GC.MyChar);
                                                GC.MyChar.EquipStats(Pos, true);

