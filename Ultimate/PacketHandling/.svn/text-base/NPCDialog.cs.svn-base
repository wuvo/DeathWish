                                                    int AllAtributes = GC.MyChar.Str +
                                                        GC.MyChar.Agi +
                                                        GC.MyChar.Spi +
                                                        GC.MyChar.Vit + GC.MyChar.StatPoints;

                                                    GC.MyChar.Str = 0;
                                                    GC.MyChar.Agi = 0;
                                                    GC.MyChar.Spi = 0;
                                                    GC.MyChar.Vit = 1;
                                                    GC.MyChar.StatPoints = (ushort)(AllAtributes - 1);
